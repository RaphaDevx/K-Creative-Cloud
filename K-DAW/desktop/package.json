{
  "name": "k-daw",
  "version": "0.2.0",
  "productName": "K-DAW",
  "description": "AI-powered Music Production & DJ App — K-Creative Suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@electron/notarize": "^2.5.0"
  },
  "build": {
    "appId": "io.k-creative.kdaw",
    "productName": "K-DAW",
    "copyright": "Copyright © 2026 RaphaDevx",
    "afterPack": "scripts/presign-python.js",
    "afterSign": "scripts/notarize.js",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../backend/dist/kdaw-server",
        "to": "kdaw-server",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "type": "distribution",
      "notarize": false
    },
    "publish": {
      "provider": "generic",
      "url": "https://pub-f8a055810aee4622b6883b39e71485fe.r2.dev/k-daw"
    },
    "dmg": {
      "title": "K-DAW ${version}",
      "window": { "width": 580, "height": 380 }
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  }
}
