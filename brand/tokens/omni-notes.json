{
  "brand": "omni-notes",
  "colors": {
    "primary": "#4A90E2",
    "background": "#121316",
    "surface": "#1B1D22",
    "highlight_yellow": "rgba(255, 235, 59, 0.35)",
    "highlight_blue": "rgba(33, 150, 243, 0.35)",
    "highlight_green": "rgba(76, 175, 80, 0.35)",
    "highlight_pink": "rgba(233, 30, 99, 0.35)",
    "text": "#F5F5F7",
    "text_muted": "#8A8A9A",
    "border": "#2C2E35",
