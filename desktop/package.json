{
  "name": "k-creative-desktop",
  "version": "0.3.0",
  "description": "K-Creative Studio — Open-Source Creative Cloud",
  "homepage": "https://github.com/RaphaDevx/K-Creative-Cloud",
  "author": "RaphaDevx",
  "main": "main.js",
  "scripts": {
    "dev":          "electron . --no-sandbox",
    "dev:kiosk":    "electron . --no-sandbox --kiosk",
    "dev:debug":    "electron . --no-sandbox --dev",
    "build":        "electron-builder --linux AppImage deb",
    "build:mac":    "bash scripts/build-backend.sh && electron-builder --mac dmg",
    "build:win":    "electron-builder --win nsis",
    "build:all":    "electron-builder --linux AppImage deb --mac dmg --win nsis",
    "release":      "electron-builder --publish always"
  },
  "build": {
    "appId": "cloud.k-creative.studio",
    "productName": "K-Creative Studio",
    "copyright": "Copyright © 2025 RaphaDevx",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-f8a055810aee4622b6883b39e71485fe.r2.dev/k-creative",
        "channel": "latest"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "icon": "src-tauri/icons/512x512.png",
      "maintainer": "RaphaDevx"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "src-tauri/icons/512x512.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "src-tauri/icons/512x512.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "dashboard.html",
      "icon-designer.html",
      "logo-creator.html",
      "!node_modules/.cache"
    ],
    "extraFiles": [
      {
        "from": "../live_engine",
        "to": "live_engine"
      }
    ],
    "extraResources": [
      {
        "from": "../feature_flags.json",
        "to": "feature_flags.json"
      },
      {
        "from": "../studio/dist/k-creative-server",
        "to": "k-creative-server"
      },
      {
        "from": "../studio/live.html",
        "to": "live.html"
      },
      {
        "from": "../studio/index.html",
        "to": "index.html"
      },
      {
        "from": "../studio/static",
        "to": "static"
      },
      {
        "from": "../studio/workers",
        "to": "workers"
      },
      {
        "from": "../studio/headless",
        "to": "headless"
      }
    ]
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-log": "^5.2.1",
    "electron-updater": "^6.3.9",
    "@sentry/electron": "^5.6.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "24.13.3"
  }
}
