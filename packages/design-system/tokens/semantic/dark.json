{
  "semantic": {
    "bg": {
      "base":    { "$value": "{color.neutral.1000}",  "$type": "color" },
      "surface": { "$value": "{color.neutral.950}",   "$type": "color" },
      "elevated":{ "$value": "#17181D",               "$type": "color" },
      "overlay": { "$value": "rgba(0,0,0,0.7)",       "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "#F0EEFF",             "$type": "color" },
      "secondary":  { "$value": "rgba(240,238,255,.55)", "$type": "color" },
      "muted":     { "$value": "rgba(240,238,255,.28)", "$type": "color" },
      "on-accent": { "$value": "{color.neutral.0}",   "$type": "color" }
    },
    "border": {
      "default": { "$value": "rgba(255,255,255,0.07)", "$type": "color" },
      "strong":  { "$value": "rgba(255,255,255,0.13)", "$type": "color" }
    },
    "accent": {
      "default": { "$value": "{color.k-violet.500}",        "$type": "color" },
      "soft":    { "$value": "rgba(108,71,255,.15)",        "$type": "color" },
      "mid":     { "$value": "rgba(108,71,255,.35)",        "$type": "color" },
      "ring":    { "$value": "rgba(108,71,255,.5)",         "$type": "color" }
    },
    "status": {
      "success": { "$value": "#3DD68C", "$type": "color" },
      "warning": { "$value": "#FFB347", "$type": "color" },
      "error":   { "$value": "#FF6B6B", "$type": "color" },
      "info":    { "$value": "#60A5FA", "$type": "color" }
    }
  }
}
